DATABASE_URL=postgresql+psycopg://cyberrecon:change-me@localhost:5432/cyberrecon
SCAN_API_KEY=replace-with-a-long-random-secret
SUPABASE_URL=https://your-project-ref.supabase.co
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Use "inprocess" for simple local development or "celery" with Redis.
TASK_QUEUE_MODE=celery
REDIS_URL=redis://localhost:6379/0
API_PORT=8000

SCAN_RATE_LIMIT=5
SCAN_RATE_WINDOW_SECONDS=3600
NMAP_PATH=nmap
IPINFO_API_KEY=
SUBDOMAIN_API_URL=

# Optional phishing intelligence and local administrator access.
GOOGLE_WEB_RISK_API_KEY=
ADMIN_EMAILS=admin@example.com

# Server-only transactional alert delivery through Resend.
RESEND_API_KEY=
ALERT_FROM_EMAIL=CyberRecon by CGregLab Security <alerts@cgreglab.space>
ALERT_RECIPIENT_EMAIL=support@cgreglab.space
SUPPORT_EMAIL=support@cgreglab.space
PUBLIC_APP_URL=https://cgreglab.space
APP_ENVIRONMENT=development
